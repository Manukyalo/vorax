# VORAX ESP32-S3 Optimal RF Capture Configuration
CONFIG_IDF_TARGET="esp32s3"

# System Clock: 240 MHz for minimal interrupt latency during 500 Hz CSI capture
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# FreeRTOS 1000 Hz tick rate for 1ms task scheduling precision
CONFIG_FREERTOS_HZ=1000

# Wi-Fi CSI Promiscuous Configuration
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y

# LwIP High-Throughput UDP Multicast Buffers
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_IP4_FRAG=n
CONFIG_LWIP_NETIF_TX_PBUF_NUM=32

# Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Flash 80MHz QIO
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
